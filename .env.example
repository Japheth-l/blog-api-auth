PORT=5003

# Standard Atlas connection string (SRV) — try this first
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blog-api?retryWrites=true&w=majority

# If you hit "querySrv ECONNREFUSED" on your network, switch to the non-SRV
# connection string instead (get it from Atlas > Connect > Drivers > "Standard
# connection string" toggle, not the SRV one). Example shape:
# MONGO_URI=mongodb://<user>:<password>@shard-00-00.xxxxx.mongodb.net:27017,shard-00-01.xxxxx.mongodb.net:27017,shard-00-02.xxxxx.mongodb.net:27017/blog-api?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority

# Reminder: use an alphanumeric-only Atlas password. Special characters in the
# password are the most common cause of auth failures.

# JWT signing secret — at least 32 random characters, never commit the real
# value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Cloudinary — get these from cloudinary.com > Console > Settings > API Keys.
# Only needed for the cover-image upload route; the rest of the API runs fine
# without them.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
